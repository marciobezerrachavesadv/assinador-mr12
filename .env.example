# ===== AssinadorMR12 =====
PORT=3000
# Endereco publico (HTTPS em producao: a camera do celular so funciona em HTTPS)
PUBLIC_URL=http://localhost:3000
# Atras de nginx/Cloudflare Tunnel? use 1 para o IP real do signatario aparecer nas evidencias
TRUST_PROXY=0

# Primeiro administrador (criado so se nao existir nenhum usuario)
ADMIN_EMAIL=voce@mr12.com.br
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-esta-senha-longa

ORG_NAME=GRUPO MR12

# ---- Selo ICP-Brasil com o A1 da empresa (opcional) ----
# Caminho do arquivo .p12/.pfx do e-CNPJ A1 (NUNCA no repositorio) e a senha dele
ICP_P12_PATH=
ICP_P12_PASSWORD=
# Politica de assinatura ICP (AD-RB). Preencha SO depois de conferir no LPA do ITI:
ICP_POLICY_OID=
ICP_POLICY_HASH_SHA256=
ICP_POLICY_URI=
# Tamanho reservado p/ a assinatura (bytes). Aumente se a cadeia do certificado for grande
ICP_SIGNATURE_BYTES=16384

# Pasta com as raizes/intermediarias ICP-Brasil (.crt/.pem/.cer) para o validador checar a cadeia
TRUSTED_ROOTS_DIR=./certs/raizes

# E-mail da copia assinada (opcional). Sem isto o sistema funciona, mas nao envia e-mail.
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=conta@seudominio, SMTP_PASS=senha de app (16 letras)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Caixas internas que recebem copia de todo documento assinado (separe por virgula)
MAIL_COPY=

# Webhook opcional (ex.: ZapiaMR avisar no WhatsApp quando alguem assinar)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ===== So para a publicacao com Docker (docker-compose.yml) =====
# Dominio que aponta para o servidor (ex.: assinar.seudominio.com.br)
DOMINIO=assinar.exemplo.com.br
# Com Docker, o .pfx fica em certs/a1/ e o caminho no ICP_P12_PATH acima e:
# ICP_P12_PATH=/certs/a1/mr12.pfx

# Ponte com o SST MR12 (conector MCP do Claude). Gere com: openssl rand -hex 32
# Endereco do conector: PUBLIC_URL/mcp/<MCP_TOKEN>  (trate esse endereco como senha)
MCP_TOKEN=
